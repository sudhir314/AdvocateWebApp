@{
    ViewData["Title"] = "About Us";
}

@* Page Specific CSS link *@
<link rel="stylesheet" href="~/css/about-us.css" asp-append-version="true" />

<!-- 1. HERO BANNER -->
<section class="about-hero">
    <div class="container-fluid container-lg">
        <h1>Advocate Ashish Kaushik</h1>
        <p>Practicing at Punjab & Haryana High Court, Chandigarh | Justice, Integrity & Commitment</p>
    </div>
</section>

<!-- 2. STORY SECTION -->
<section class="about-story">
    <div class="container-fluid container-lg">
        <div class="story-grid">
            <div class="story-content">
                <h2>Who We Are</h2>
                <p class="lead-description">Led by Advocate Ashish Kaushik, our practice is deeply rooted in delivering justice and expert legal counsel at the prestigious Punjab and Haryana High Court in Chandigarh.</p>
                <p>With a profound understanding of complex legal frameworks, we specialize in high-stakes civil, criminal, and corporate litigation. Our approach combines aggressive courtroom advocacy with personalized, strategic planning to protect our clients' rights and secure favorable legal outcomes across the region.</p>
            </div>
            <div class="story-image">
                <img src="~/images/about/Ashish.jpeg" alt="Law Firm Office" />
            </div>
        </div>
    </div>
</section>

<!-- 3. MISSION & VISION -->
<section class="mission-vision">
    <div class="container-fluid container-lg">
        <div class="mv-grid">
            <div class="mv-card">
                <h3>Our Mission</h3>
                <p>To provide clear, strategic, and relentless legal representation at the High Court level, ensuring every client receives a fair trial, transparency, and the highest standard of legal ethics.</p>
            </div>
            <div class="mv-card">
                <h3>Our Vision</h3>
                <p>To be the most trusted and results-driven legal practice in Chandigarh, known for our integrity, deep legal acumen, and high success rate in landmark judgments.</p>
            </div>
        </div>
    </div>
</section>

<!-- 4. CORE VALUES -->
<section class="core-values">
    <div class="container-fluid container-lg">
        <h2 class="section-title">Our Core Values</h2>
        <div class="values-grid">
            <div class="value-card">
                <h4>Integrity & Ethics</h4>
                <p>We strictly adhere to the Bar Council's professional standards, ensuring complete honesty in every High Court matter we represent.</p>
            </div>
            <div class="value-card">
                <h4>Client Confidentiality</h4>
                <p>Your privacy and sensitive case documents are 100% safeguarded under absolute attorney-client privilege.</p>
            </div>
            <div class="value-card">
                <h4>Relentless Advocacy</h4>
                <p>From district courts to the High Court of Chandigarh, we fight strategically to achieve the best possible resolution for you.</p>
            </div>
        </div>
    </div>
</section>

<!-- 5. OUR JOURNEY / TIMELINE -->
<section class="timeline-section">
    <div class="container-fluid container-lg">
        <h2 class="section-title">Our Journey</h2>
        <div class="timeline">
            <div class="timeline-item">
                <div class="dot"></div>
                <div>
                    <h5>2015</h5>
                    <p>Started Legal Practice</p>
                </div>
            </div>
            <div class="timeline-item">
                <div class="dot"></div>
                <div>
                    <h5>2018</h5>
                    <p>District Court Success</p>
                </div>
            </div>
            <div class="timeline-item">
                <div class="dot"></div>
                <div>
                    <h5>2021</h5>
                    <p>Expanded to High Court, Chandigarh</p>
                </div>
            </div>
            <div class="timeline-item">
                <div class="dot"></div>
                <div>
                    <h5>Present</h5>
                    <p>Handling Landmark Cases</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 6. MEET THE TEAM -->
<section class="team-section">
    <div class="container-fluid container-lg">
        <h2 class="section-title">Meet The Counsel</h2>
        <div class="team-grid">
            <div class="team-card">
                <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=500&q=80" alt="Advocate Ashish Kaushik" />
                <div class="team-info">
                    <h3>Advocate Ashish Kaushik</h3>
                    <p>Lead Counsel, Punjab & Haryana High Court</p>
                </div>
            </div>
            <div class="team-card">
                <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=500&q=80" alt="Associate Lawyer" />
                <div class="team-info">
                    <h3>Associate Counsel</h3>
                    <p>Civil & Criminal Litigation</p>
                </div>
            </div>
            <div class="team-card">
                <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=500&q=80" alt="Legal Advisor" />
                <div class="team-info">
                    <h3>Legal Research Team</h3>
                    <p>Case Strategy & Documentation</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 7. AFFILIATIONS -->
<section class="affiliations">
    <div class="container-fluid container-lg">
        <h3 style="color: #FFFFFF; font-family: var(--font-heading);">Recognized & Affiliated With</h3>
        <div class="badges-flex">
            <div class="badge-item">Punjab & Haryana High Court Bar Association</div>
            <div class="badge-item">Bar Council of Punjab & Haryana</div>
            <div class="badge-item">District Bar Association, Chandigarh</div>
        </div>
    </div>
</section>

<!-- 8. CALL TO ACTION BANNER -->
<section class="cta-banner">
    <div class="container-fluid container-lg">
        <h2>Need Representation at Chandigarh High Court?</h2>
        <p>Schedule a confidential legal consultation with Advocate Ashish Kaushik today.</p>
        <a href="/Home/Contact" class="btn btn-primary btn-lg">Book Consultation</a>
    </div>
</section>

@section Styles{
    <link rel="stylesheet" href="~/css/about.css"/>
}