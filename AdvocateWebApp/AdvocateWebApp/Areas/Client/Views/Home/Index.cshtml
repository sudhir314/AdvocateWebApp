                        <span class="case-type"><i class="bi bi-shield-check"></i> Family Law</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- VIEW ALL TESTIMONIALS CTA -->
        <div class="text-center mt-5">
            <a href="#testimonials-page" class="btn btn-outline-primary">
                View All Client Reviews <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</section>

