@{
    ViewData["Title"] = "Home - Legal Services";
}

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="hero-container">
        <div class="hero-content">
            <span class="sub-heading">PROFESSIONAL LEGAL EXCELLENCE</span>
            <h1>Dedicated to Protecting Your Rights &amp; Achieving Results.</h1>
            <p>Expert legal representation across diverse areas of law. Trusted counsel for individuals and corporate clients.</p>
            <div class="hero-cta">
                <a href="#appointment" class="btn btn-primary btn-lg">Book An Appointment</a>
                <span class="badge-tag">(Get Free Initial Consultation)</span>
            </div>
        </div>
    </div>
</section>

<!-- PRACTICE AREAS SECTION -->
<section class="practice-areas py-5">
    <div class="container">
        <div class="section-header text-center mb-5">
            <span class="sub-heading">OUR LEGAL SERVICES</span>
            <h2 class="section-title">Key Practice Areas</h2>
        </div>

        <div class="card-grid">
            <div class="card">
                <i class="bi bi-bank icon" aria-hidden="true"></i>
                <h3>Corporate Law</h3>
                <p>Expert representation in corporate governance, regulatory compliance, and commercial disputes.</p>
                <a href="#" class="card-link" aria-label="Learn more about Corporate Law">Learn More &rarr;</a>
            </div>
            <div class="card">
                <i class="bi bi-shield-lock icon" aria-hidden="true"></i>
                <h3>Criminal Defense</h3>
                <p>Protecting your constitutional rights in complex investigations, bail matters, and trial litigation.</p>
                <a href="#" class="card-link" aria-label="Learn more about Criminal Defense">Learn More &rarr;</a>
            </div>
            <div class="card">
                <i class="bi bi-people icon" aria-hidden="true"></i>
                <h3>Family Law</h3>
                <p>Compassionate legal guidance for divorce, child custody, asset division, and domestic relations.</p>
                <a href="#" class="card-link" aria-label="Learn more about Family Law">Learn More &rarr;</a>
            </div>
            <div class="card">
                <i class="bi bi-house-door icon" aria-hidden="true"></i>
                <h3>Property Law</h3>
                <p>Comprehensive legal support for real estate acquisitions, property disputes, and title registration.</p>
                <a href="#" class="card-link" aria-label="Learn more about Property Law">Learn More &rarr;</a>
            </div>
        </div>

        <!-- VIEW ALL PRACTICE AREAS CTA -->
        <div class="text-center mt-5">
            <a href="#practice-areas-mega" class="btn btn-outline-primary">
                View All Practice Areas <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</section>

<!-- WHY CHOOSE US SECTION -->
<section class="why-choose-us">
    <div class="container">
        <div class="section-header text-center mb-5">
            <span class="sub-heading">YOUR TRUSTED LEGAL PARTNER</span>
            <h2 class="section-title">Why Choose Our Firm</h2>
            <p class="section-subtitle">Delivering strategic advocacy, uncompromised integrity, and proven courtroom results.</p>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-bank2" aria-hidden="true"></i>
                </div>
                <div class="feature-content">
                    <h3>Deep Legal Expertise</h3>
                    <p>Backed by decades of combined trial experience across corporate, criminal, and civil courts.</p>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                </div>
                <div class="feature-content">
                    <h3>Proven Track Record</h3>
                    <p>A history of winning high-stakes legal cases and securing advantageous settlements.</p>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-person-bounding-box" aria-hidden="true"></i>
                </div>
                <div class="feature-content">
                    <h3>Client-First Approach</h3>
                    <p>Direct accessibility to lead counsel with personalized strategies tailored to your objectives.</p>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-cash-stack" aria-hidden="true"></i>
                </div>
                <div class="feature-content">
                    <h3>Transparent Fee Structure</h3>
                    <p>Clear, upfront pricing with zero hidden charges—focused on maximum value and absolute honesty.</p>
                </div>
            </div>
        </div>
    </div>
</section>

